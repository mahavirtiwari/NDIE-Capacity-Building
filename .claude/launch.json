{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "training-portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "training-portal",
        "run",
        "start"
      ],
      "port": 4200
    },
    {
      "name": "applicant-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "run",
        "web"
      ],
      "port": 8081
    },
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "backend/src/Ntms.Api",
        "--launch-profile",
        "http",
        "--",
        "--urls",
        "http://localhost:5210"
      ],
      "port": 5210
    }
  ]
}
