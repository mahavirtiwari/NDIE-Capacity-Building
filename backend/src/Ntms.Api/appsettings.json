{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "ntms-api",
    "Audience": "ntms-clients",
    "SigningKey": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedSampleData": false
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "no-reply@ntms.gov.in",
    "FromName": "Capacity Building Management System",
    "ReplyTo": "support@ntms.gov.in",
    "RedirectAllTo": null,
    "TimeoutSeconds": 30,
    "OtpValidityMinutes": 10
  }
}
