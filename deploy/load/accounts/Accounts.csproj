<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ntms.Load.Accounts</RootNamespace>
    <AssemblyName>accounts</AssemblyName>
    <!-- Not part of the solution: this is a deployment tool that runs on
         the server, and nothing in the application references it. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same two packages, at the same versions, the application
         itself uses: the hasher has to agree with the one that checks
         sign-in, and the narrower package avoids dragging in half of
         ASP.NET - and its advisories - for one class. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />
    <!-- Through EF, as the application takes it, so this tool pulls
         the same SqlClient the server already has rather than a
         second one with its own advisories. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
  </ItemGroup>

</Project>
