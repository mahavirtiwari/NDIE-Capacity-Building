<?xml version="1.0" encoding="utf-8"?>
<!--
  What IIS will accept, raised to match what the application already says
  it accepts.

  Publishing generates most of this file - the ASP.NET Core handler and the
  module entry are written in by the SDK at publish time and must not be
  typed here. What the generated one does not carry is a request limit, so
  IIS applies its own default of 30,000,000 bytes, about 28.6 MB, and
  rejects anything larger before ASP.NET Core is reached at all. The caller
  gets a bare 404.13 from IIS rather than the message the endpoint would
  have given them.

  That default sits below what three upload paths are written to allow.
  Training material declares 512 MB, which is the point of it - a recorded
  session is a video. A profile file field may be configured up to 64 MB.
  Both would have failed at 28.6 MB with nothing useful said.

  Set to 512 MB, which is the largest any endpoint allows. It is a ceiling
  and not a promise: each endpoint still carries its own RequestSizeLimit,
  and the material store still refuses anything over the size set in System
  Settings, with a message that explains itself. This only stops IIS
  refusing first and refusing badly.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="536870912" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
