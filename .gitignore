# Build output
**/bin/
**/obj/
**/dist/
**/.angular/
**/.expo/

# Dependencies
**/node_modules/

# Captured monitoring photographs. These are evidence files belonging to a
# deployment, not source, and some carry personal data.
**/App_Data/

# Local developer settings and editor state
*.user
*.suo
.vs/
.idea/
.vscode/
*.log

# Anything holding real credentials. Configuration ships with empty values;
# actual secrets belong in user-secrets, environment variables or a vault.
appsettings.*.local.json
.env
.env.*
*.pfx

# Generated by expo prebuild on every APK build, deleted after. Never edited
# by hand, so never committed.
mobile/android/
mobile/ios/
mobile-coordinator/android/
mobile-coordinator/ios/

# The portal is built into the API's wwwroot at publish time. A developer who
# copies a build there to see the two halves served as one — which is how they
# run in production — should not find it staged for commit.
backend/src/Ntms.Api/wwwroot/
